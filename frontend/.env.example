# Origin of the NestJS backend, including its global `api` prefix (set in
# main.ts). This is the *backend* tunnel, never the frontend one — the boot gate
# calls /store/check-installation through it and builds the top-frame OAuth URL
# from it, so pointing it at the frontend makes Vite answer with index.html and
# the app never boots. No trailing slash.
VITE_API_URL=http://localhost:3001/api

# The app's Shopify client ID. App Bridge reads it from the script tag's
# `data-api-key`; it is public by design — the secret never leaves the backend.
# Must match `client_id` in shopify.app.toml and SHOPIFY_API_KEY in backend/.env.
VITE_SHOPIFY_API_KEY=your_shopify_api_key

# Public hostname the dev-server tunnel serves on, so Vite HMR opens its
# websocket there instead of localhost. Leave unset when not tunnelling.
VITE_TUNNEL_HOST=
