# Origin of the NestJS backend. The boot gate also builds the top-frame OAuth
# URL from this, so it must be reachable from the browser, not just from Docker.
VITE_API_URL=http://localhost:3000

# The app's Shopify client ID. App Bridge reads it from the script tag's
# `data-api-key`; it is public by design — the secret never leaves the backend.
VITE_SHOPIFY_API_KEY=your_shopify_api_key
